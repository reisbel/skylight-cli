# Copy to .env and fill in. .env is gitignored and must never be committed.
SKYLIGHT_EMAIL=you@example.com

# Leave SKYLIGHT_PASSWORD unset to be prompted at `skylight login`.
# That keeps the password out of your shell history and process list.
# SKYLIGHT_PASSWORD=

# Optional. Discovered automatically from `skylight frames` if unset.
# SKYLIGHT_FRAME_ID=
