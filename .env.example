# Copy to ~/.config/skylight-cli/.env (preferred, works from any directory)
# or to ./.env here. Both are gitignored; never commit real credentials.

SKYLIGHT_EMAIL=you@example.com

# Either a literal password, or an op:// reference resolved at run time by the
# 1Password CLI so the secret never touches disk.
SKYLIGHT_PASSWORD=op://Personal/Skylight/password

# Optional. Discovered automatically from `skylight frames` if unset.
# SKYLIGHT_FRAME_ID=
